<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Translate.Gemini_Url">URL</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Translate.Gemini_Url_Description">Gemini API のアドレスを設定します。&#x0a;通常はパスの入力は不要です。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Translate.Gemini_ApiKey">API キー</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Translate.Gemini_ApiKey_Placeholder">API キーを入力</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Translate.Gemini_ApiKey_Description">Gemini API キーを入力してください。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Translate.Gemini_Model">モデルを選択</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Translate.Gemini_Prompt_Header">プロンプト設定</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Translate.Gemini_Prompt_Description">翻訳に使うプロンプトテンプレートを選択または編集します。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Translate.Gemini_Prompt_Placeholder">プロンプトテンプレートを選択</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Translate.Gemini_EditPrompt_ToolTip">プロンプトを編集</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Translate.Gemini_EditPrompt_Content">編集</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Translate.Gemini_Temperature">温度</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Translate.Gemini_Temperature_Description">モデルの出力のランダム性を調整します。</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Translate.Gemini_ThinkingBudget">思考バジェット</sys:String>
    <sys:String x:Key="STranslate_Plugin_Translate_STranslate.Plugin.Translate.Gemini_ThinkingBudget_Description">−1 は自動、0 は無効です。正の整数は思考に使うトークンの上限を指定します。</sys:String>

</ResourceDictionary>
